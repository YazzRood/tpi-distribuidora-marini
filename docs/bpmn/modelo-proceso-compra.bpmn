<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_Marini" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)">
  <bpmn:collaboration id="Collab_Marini">
    <bpmn:participant id="P_Prov" name="Proveedor" />
    <bpmn:participant id="P_Marini" name="Distribuidora Marini" processRef="Proc_Compra" />
    <bpmn:participant id="P_Cli" name="Clientes (comercios)" />
    <bpmn:messageFlow id="M1" name="Mercadería y factura" sourceRef="P_Prov" targetRef="Start" />
    <bpmn:messageFlow id="M2" name="Reclamo" sourceRef="T_Reclamar" targetRef="P_Prov" />
    <bpmn:messageFlow id="M3" name="Lista de precios" sourceRef="End_Lista" targetRef="P_Cli" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Compra" name="Recepción de compras, costeo y actualización de precios" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_Compras" name="Compras">
        <bpmn:flowNodeRef>T_Reclamar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Quedo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rechazada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Deposito" name="Depósito">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Controlar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_LlegoBien</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Union1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Nuevos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Union2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Cargar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sistema" name="Sistema (módulo)">
        <bpmn:flowNodeRef>G_Union3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Costo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Precios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Suba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Union4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Publicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lista</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Direccion" name="Dirección General">
        <bpmn:flowNodeRef>T_Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Aprueba</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Admin" name="Administración y Finanzas">
        <bpmn:flowNodeRef>T_Alta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Corregir</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Llega la mercadería con la factura">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start" />
    </bpmn:startEvent>
    <bpmn:manualTask id="T_Controlar" name="Controlar cantidad, frío y vencimientos">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G_LlegoBien" name="¿Llegó todo bien?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_Union1" name="">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_Nuevos" name="¿Hay artículos nuevos?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_Union2" name="">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Cargar" name="Cargar la compra y sus lotes">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T_Reclamar" name="Reclamar la diferencia al proveedor">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="G_Quedo" name="¿Quedó algo para cargar?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rechazada" name="Entrega rechazada">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Union3" name="">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Costo" name="Calcular costo y stock">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA1"><bpmn:targetRef>DS1_ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Precios" name="Calcular precios nuevos">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA2"><bpmn:targetRef>DS1_ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Suba" name="¿Algún artículo sube más del 15 %?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_Union4" name="">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Publicar" name="Publicar la lista nueva">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA3"><bpmn:targetRef>DS2_ref</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Lista" name="Lista enviada a los clientes">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:messageEventDefinition id="MED_End_Lista" />
    </bpmn:endEvent>
    <bpmn:userTask id="T_Revisar" name="Revisar la suba">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Aprueba" name="¿Aprueba la suba?">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Alta" name="Dar de alta el artículo">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Corregir" name="Corregir la carga">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Controlar" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Controlar" targetRef="G_LlegoBien" />
    <bpmn:sequenceFlow id="F3" name="Sí" sourceRef="G_LlegoBien" targetRef="G_Union1" />
    <bpmn:sequenceFlow id="F4" name="No" sourceRef="G_LlegoBien" targetRef="T_Reclamar" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_Reclamar" targetRef="G_Quedo" />
    <bpmn:sequenceFlow id="F6" name="No" sourceRef="G_Quedo" targetRef="End_Rechazada" />
    <bpmn:sequenceFlow id="F7" name="Sí" sourceRef="G_Quedo" targetRef="G_Union1" />
    <bpmn:sequenceFlow id="F8" sourceRef="G_Union1" targetRef="G_Nuevos" />
    <bpmn:sequenceFlow id="F9" name="No" sourceRef="G_Nuevos" targetRef="G_Union2" />
    <bpmn:sequenceFlow id="F10" name="Sí" sourceRef="G_Nuevos" targetRef="T_Alta" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_Alta" targetRef="G_Union2" />
    <bpmn:sequenceFlow id="F12" sourceRef="G_Union2" targetRef="T_Cargar" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_Cargar" targetRef="G_Union3" />
    <bpmn:sequenceFlow id="F14" sourceRef="G_Union3" targetRef="T_Costo" />
    <bpmn:sequenceFlow id="F15" sourceRef="T_Costo" targetRef="T_Precios" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_Precios" targetRef="G_Suba" />
    <bpmn:sequenceFlow id="F17" name="No" sourceRef="G_Suba" targetRef="G_Union4" />
    <bpmn:sequenceFlow id="F18" name="Sí" sourceRef="G_Suba" targetRef="T_Revisar" />
    <bpmn:sequenceFlow id="F19" sourceRef="T_Revisar" targetRef="G_Aprueba" />
    <bpmn:sequenceFlow id="F20" name="Sí" sourceRef="G_Aprueba" targetRef="G_Union4" />
    <bpmn:sequenceFlow id="F21" name="No" sourceRef="G_Aprueba" targetRef="T_Corregir" />
    <bpmn:sequenceFlow id="F22" sourceRef="T_Corregir" targetRef="G_Union3" />
    <bpmn:sequenceFlow id="F23" sourceRef="G_Union4" targetRef="T_Publicar" />
    <bpmn:sequenceFlow id="F24" sourceRef="T_Publicar" targetRef="End_Lista" />
    <bpmn:dataStoreReference id="DS1_ref" name="Base de datos del módulo" />
    <bpmn:dataStoreReference id="DS2_ref" name="Base de datos del módulo" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1"><bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_Marini">
    <bpmndi:BPMNShape id="P_Prov_di" bpmnElement="P_Prov" isHorizontal="true"><dc:Bounds x="6" y="6" width="1828" height="59" /></bpmndi:BPMNShape>
